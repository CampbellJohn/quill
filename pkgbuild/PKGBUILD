# Maintainer: John Campbell <j.campb@gmail.com>

pkgname=quill
pkgver=0.1.0
pkgrel=1
pkgdesc='Minimalist prose writing app with live Markdown preview (fork of Omawrite)'
arch=('x86_64')
url='https://github.com/CampbellJohn/quill'
license=('MIT')
install='quill.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal' 'python' 'pandoc-cli' 'typst')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/quill "$pkgdir/usr/bin/quill"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/quill.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/quill.svg"
  for file in quill.lua import.lua manuscript.typ book.typ; do
    /usr/bin/install -Dm644 "export/$file" "$pkgdir/usr/share/quill/$file"
  done
  /usr/bin/install -Dm755 export/quill-export "$pkgdir/usr/share/quill/quill-export"
  /usr/bin/install -Dm644 "$startdir/quill.desktop" "$pkgdir/usr/share/applications/quill.desktop"
}
