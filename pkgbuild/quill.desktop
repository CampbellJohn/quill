[Desktop Entry]
Type=Application
Name=Quill
GenericName=Prose Writer
Comment=Minimalist writing app for stories, with live Markdown preview
Exec=quill %f
Icon=quill
Terminal=false
Categories=Office;WordProcessor;TextEditor;
